# Azure OpenAI endpoint, for example: https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI deployment name, not the base model name.
AZURE_OPENAI_DEPLOYMENT=
# Update only to an API version supported by the selected deployment.
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure OpenAI embedding deployment used by document ingestion and retrieval.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Azure AI Search endpoint and index. The server authenticates with DefaultAzureCredential.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=ngcp-demo-documents
# Private Blob container that stores the canonical source documents.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=ngcp-demo-documents